#!/usr/bin/env bash
set -Eeuo pipefail

backup_root="${BACKUP_ROOT:-}"
media_root="${TEST_MEDIA_ROOT:-}"
state_file="${MTX_MOCK_STATE:-/tmp/mtx-mock.state}"

if [[ "$#" -ge 3 && "${1:-}" == "-B1" && "${2:-}" == "--output=avail" && "${3:-}" == "$backup_root" && -n "$media_root" ]]; then
  if [[ -f "$state_file" ]]; then
    # shellcheck disable=SC1090
    source "$state_file"
  fi

  tag="${DRIVE_TAG:-}"
  if [[ -z "$tag" ]]; then
    echo "Avail"
    echo 0
    exit 0
  fi

  media_dir="$media_root/$tag"
  capacity_file="$media_dir/.capacity_bytes"
  capacity=0
  used=0

  if [[ -f "$capacity_file" ]]; then
    capacity=$(<"$capacity_file")
  fi

  if [[ -d "$media_dir" ]]; then
    used=$(find "$media_dir" -type f -exec stat --format='%s' {} + 2>/dev/null | awk '{s+=$1}END{print s+0}')
  fi

  avail=$(( capacity - used ))
  if (( avail < 0 )); then
    avail=0
  fi

  echo "Avail"
  echo "$avail"
  exit 0
fi

exec /bin/df "$@"