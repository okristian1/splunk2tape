[Unit]
Description=Splunk cold bucket backup to tape
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Tape writes and LTFS metadata updates must not be interrupted by an
# automatic service timeout. A wedged run requires operator intervention.
TimeoutStartSec=infinity
# The script is systemd's MainPID and handles TERM by unmounting LTFS first.
# Do not SIGKILL a hung LTFS process; investigate and recover the tape manually.
KillMode=mixed
TimeoutStopSec=infinity
SendSIGKILL=no
# Optional environment overrides, for example:
# LOG_LEVEL=info
# DRY_RUN=0
EnvironmentFile=-/etc/default/splunk-tape-backup
ExecStart=/usr/bin/env bash /opt/splunk_tape_backup/backup-to-tape.sh
WorkingDirectory=/opt/splunk_tape_backup
User=root
Group=root

[Install]
WantedBy=multi-user.target
